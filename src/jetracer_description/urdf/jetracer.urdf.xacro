<?xml version="1.0"?>
<robot name="jetracer" xmlns:xacro="http://www.ros.org/wiki/xacro">

     <xacro:property name="scale" value="3"/>
     <xacro:property name="wheel_offset_frac" value="0.25"/>

   <xacro:property name="base_length" value="${0.2499 * scale}"/>
    <xacro:property name="base_width" value="${0.1922 * scale}"/>
    <xacro:property name="base_height" value="${0.06 * scale}"/>
    <xacro:property name="wheel_radius" value="${0.04 * scale}"/>
    <xacro:property name="wheel_length" value="${0.025 * scale}"/>
    
    
    <xacro:include filename= "common_properties.xacro"/>
    <xacro:include filename="jetracer_gazebo.xacro"/>  
    <xacro:include filename="camera.xacro"/>
    <xacro:include filename="lidar.xacro"/>


    <xacro:macro name="steering_wheel" params="position side sign">
       
        <xacro:if value="${position=='front'}">
            <link name="${position}_${side}_steer_link">
                <xacro:cylinder_inertial m="0.3" r="${wheel_radius}" l="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0"/>
              </link>
            <!-- 1) steering joint -->
            <joint name="${position}_${side}_steer_joint" type="revolute">
                <parent link="base_link"/>
                <child  link="${position}_${side}_steer_link"/>
                <!-- position at same x,y,z as wheel -->
                <origin xyz="${
                    base_length/2.4
                } ${
                    sign * base_width * 0.63
                } ${-(base_height*wheel_offset_frac)}" rpy="0 0 0"/>
                <axis  xyz="0 0 1"/>
                <limit lower="-0.785" upper="0.785" effort="40" velocity="4"/>
            </joint>

           

            <!-- 2) then the rolling wheel joint, parented to the steer_link -->
            <joint name="${position}_${side}_wheel_joint" type="continuous">
                <parent link="${position}_${side}_steer_link"/>
                <child  link="${position}_${side}_wheel"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <axis  xyz="0 1 0"/>
            </joint>
            <link name="${position}_${side}_wheel">
                <visual>
                    <geometry>
                        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                    </geometry>
                    <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                    <material name="black"/>
                </visual>
                <collision>
                    <geometry>
                        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                    </geometry>
                    <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                
                </collision>
                <xacro:cylinder_inertial m="0.3" r="${wheel_radius}" l="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0"/>
        </link>
        </xacro:if>

        <xacro:if value="${position!='front'}">
            <!-- rear wheels unchanged -->
            <joint name="${position}_${side}_wheel_joint" type="continuous">
                <parent link="base_link"/>
                <child  link="${position}_${side}_wheel"/>
                
                <origin xyz="${-0.1*scale} ${sign * base_width * 0.63} ${-(base_height * wheel_offset_frac)}" rpy="0 0 0"/>
                <axis xyz="0 1 0"/>
            </joint>
            <link name="${position}_${side}_wheel">
                <visual>
                    <geometry>
                        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                    </geometry>
                    <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                    <material name="black"/>
                </visual>
                <collision>
                    <geometry>
                        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                    </geometry>
                    <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                
                </collision>
                <xacro:cylinder_inertial m="0.3" r="${wheel_radius}" l="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0"/>
            </link>
        </xacro:if>
    </xacro:macro>

  

    <link name="base_footprint" />
    

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${0.05 * scale}" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="green" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:box_inertial m="1.2" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 0" o_rpy="0 0 0"/>
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>1</update_rate>
            <visualize>true</visualize>
            <topic>imu</topic>
        </sensor>
    </link>


    <xacro:steering_wheel position="front" side="left" sign="1"/>
    
    
    <xacro:steering_wheel position="front" side="right" sign="-1"/>


    
    <xacro:steering_wheel position="rear" side="left" sign="1"/>
    
    
    <xacro:steering_wheel position="rear" side="right" sign="-1"/>

</robot>
