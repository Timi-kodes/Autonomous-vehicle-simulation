<?xml version="1.0"?>
<robot name="jetracer" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_link_length" value="0.2499"/>
    <xacro:property name="base_link_width" value="0.1922"/>
    <xacro:property name="base_height" value="0.12"/>
    <xacro:property name="wheel_radius" value="0.0325"/>
    <xacro:property name="wheel_length" value="0.025"/>

    
    <xacro:macro name="wheel" params="position side sign">
        <joint name="${position}_${side}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${position}_${side}_wheel"/>
            <origin xyz="${ base_link_length/3.5 if position=='front' else -0.1 } ${sign * base_link_width * 0.57} -0.06" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
        <link name="${position}_${side}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                <material name="blue"/>
            </visual>
        </link>
    </xacro:macro>

    <xacro:include filename= "common_properties.xacro"/>
       

    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0925" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_link_length} ${base_link_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="green" />
        </visual>
    </link>

    <joint name="base_scan_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_scan"/>
        <origin xyz="0 0 0.07" rpy="0 0 0"/>
    </joint>

    <link name="base_scan">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
    </link>
    


    <link name="camera">
	  <visual>
	    <geometry> 
	      <box size="0.03 0.03 0.013"/>
	    </geometry>
	     <origin xyz="0 0 0" rpy="0 0 0" />
	    <material name="grey"/>	     
	  </visual>	  
    </link>


   <joint name="camera_joint" type="fixed">
	  <parent link="base_link"/>
	  <child link="camera"/>
	  <origin xyz="0.13 0 0.045" rpy="0 0 0"/>
   </joint>

    
    <xacro:wheel position="front" side="left" sign="1"/>
    
    
    <xacro:wheel position="front" side="right" sign="-1"/>

    
    <xacro:wheel position="rear" side="left" sign="1"/>
    
    
    <xacro:wheel position="rear" side="right" sign="-1"/>

</robot>
