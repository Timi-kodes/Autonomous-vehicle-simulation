<?xml version="1.0"?>
<robot name="jetracer" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.2499"/>
    <xacro:property name="base_width" value="0.1922"/>
    <xacro:property name="base_height" value="0.12"/>
    <xacro:property name="wheel_radius" value="0.0325"/>
    <xacro:property name="wheel_length" value="0.025"/>

    
    <xacro:macro name="wheel" params="position side sign">
        <joint name="${position}_${side}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${position}_${side}_wheel"/>
            <origin xyz="${ base_length/3.5 if position=='front' else -0.1 } ${sign * base_width * 0.63} -0.06" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
        <link name="${position}_${side}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            </collision>
            <xacro:cylinder_inertial m="0.3" radius="${wheel_radius}" length="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0"/>
        </link>
    </xacro:macro>


    <xacro:macro name="wheel_link" params="position side sign">
        <joint name="${position}_${side}_wheel_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${position}_${side}_wheel"/>
            <origin xyz="${ base_length/3.5 if position=='front' else -0.1 } ${sign * base_width * 0.63} -0.06" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
        <link name="${position}_${side}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            </collision>
            <xacro:cylinder_inertial m="0.3" radius="${wheel_radius}" length="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0"/>
        </link>
    </xacro:macro>

    <xacro:include filename= "common_properties.xacro"/>
    <xacro:include filename="jetracer_gazebo.xacro"/>    

    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0925" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="green" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:box_inertial m="1.2" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="base_scan_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_scan"/>
        <origin xyz="0 0 0.07" rpy="0 0 0"/>
    </joint>

    <link name="base_scan">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertial m="0.1" radius="0.05" length="0.04" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>
    


    <link name="camera">
	  <visual>
	    <geometry> 
	      <box size="0.03 0.03 0.013"/>
	    </geometry>
	     <origin xyz="0 0 0" rpy="0 0 0" />
	    <material name="grey"/>	     
	  </visual>
      <collision>
        <geometry> 
          <box size="0.03 0.03 0.013"/>
        </geometry>
         <origin xyz="0 0 0" rpy="0 0 0" />
      </collision>
      <xacro:box_inertial m="0.1" x="0.03" y="0.03" z="0.013" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>


   <joint name="camera_joint" type="fixed">
	  <parent link="base_link"/>
	  <child link="camera"/>
	  <origin xyz="0.13 0 0.045" rpy="0 0 0"/>
   </joint>

    
    <xacro:wheel position="front" side="left" sign="1"/>
    
    
    <xacro:wheel position="front" side="right" sign="-1"/>

    
    <xacro:wheel position="base" side="left" sign="1"/>
    
    
    <xacro:wheel position="base" side="right" sign="-1"/>
    
</robot>
