<launch>
    <let name="urdf_path" 
        value="$(find-pkg-share jetracer_description)/urdf/jetracer.urdf.xacro"/>

    <let name="rviz_config_path"
        value="$(find-pkg-share jetracer_description)/rviz/jetracer.rviz"/>

    <let name="gazebo_config_path"
        value="$(find-pkg-share jetracer_bringup)/config/gazebo_bridge.yaml"/>

    <let name="slam_config_path"
        value="$(find-pkg-share jetracer_bringup)/config/mapper_params_online_async.yaml"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')" />
        <param name="use_sim_time" value="true"/>
    </node>
    
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(find-pkg-share jetracer_bringup)/worlds/custom_world.sdf -r"/>
         <!-- <arg name="gz_args" value="empty.sdf -r"/> -->
    </include>

    <!-- <include file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py" >
    <arg name="slam_pramas_file" value="$(var slam_config_path)"/>
</include> -->
 
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description" output="screen"/>

 


    <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
        <param name="config_file" value="$(var gazebo_config_path)" />
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="rviz2" exec="rviz2" output="screen" 
          args="-d $(var rviz_config_path)">
        <param name="use_sim_time" value="true"/>
    </node>
    
</launch>
